# Copy to backend/.env; never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=8
EKT_USERNAME=
EKT_PASSWORD=
EKT_TIMEOUT_SECONDS=5
CATALOG_DB=data/catalog.sqlite3
CATALOG_STALE_SECONDS=300
# Enable live checks only after setting EKT credentials.
EKT_LIVE_ENABLED=false
# JSON list, no wildcard. Frontend dev server:
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PURCHASE_TERMS_PATH=data/purchase_terms.json
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=1000
CHAT_REQUESTS_PER_MINUTE=30
# Local prototype cart; never changes the cart on ekt.kz.
DEMO_CART_ENABLED=true
CART_PROPOSAL_TTL_SECONDS=300
CART_COOKIE_SECURE=false
CART_REQUESTS_PER_MINUTE=60
# External HTTPS demo: set true and supply credentials through hosting secrets.
PUBLIC_DEMO=false
PUBLIC_DEMO_USERNAME=
PUBLIC_DEMO_PASSWORD=
PUBLIC_DEMO_COOKIE_SECURE=true
PUBLIC_DEMO_REQUESTS_PER_MINUTE=120
PUBLIC_DEMO_MAX_REQUESTS=1000
PUBLIC_DEMO_COOKIE_TTL_SECONDS=28800
PUBLIC_DEMO_MAX_BODY_BYTES=65536
# Launcher-only settings; these must be process/hosting environment variables.
# PORT=8000
# TRUSTED_PROXY_IPS=127.0.0.1
# DEMO_SEED_SYNTHETIC=false
